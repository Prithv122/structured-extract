# Copy to .env and fill in. Never commit .env.
# These are the only environment variables this project reads.

# Hosted arms (H1-H4). Required only for `structured-extract extract --arm h*`.
# Every published number replays from the committed cache bundle WITHOUT this key.
OPENROUTER_API_KEY=

# Local arm (L1). Defaults to http://localhost:11434 when unset.
# OLLAMA_HOST=http://localhost:11434
