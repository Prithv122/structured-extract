# Copy to .env and fill in. Never commit .env.
# These are the only environment variables this project reads.

# Hosted arms (H1-H4). Required ONLY by `structured-extract extract run --live`,
# which issues real, billed requests for anything not already cached.
# `extract run` without --live, and every published number, replay from the
# committed cache with this left empty.
# `structured-extract arms verify` needs no key at all: the model catalogue is public.
OPENROUTER_API_KEY=

# Local arm (L1). Defaults to http://localhost:11434 when unset.
# OLLAMA_HOST=http://localhost:11434
